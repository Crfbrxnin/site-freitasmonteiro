# ─────────────────────────────────────────────────────────────
# Bruno Freitas Contabilidade — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure no provedor de hospedagem.
# NENHUMA destas variáveis é enviada ao navegador, exceto as que começam com NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# URL pública do site (sem barra no final). Usada em canonical, sitemap e Open Graph.
SITE_URL=https://www.seudominio.com.br

# Banco de dados (libSQL / SQLite).
#   Local/VPS: file:./data/site.db
#   Turso (recomendado para Vercel): libsql://<seu-banco>.turso.io
DATABASE_URL=file:./data/site.db
DATABASE_AUTH_TOKEN=

# Segredo da sessão do painel. Gere com: openssl rand -base64 48
SESSION_SECRET=

# Primeiro administrador — criado automaticamente apenas se ainda não houver usuários.
# Depois do primeiro login, troque a senha no painel e remova estas variáveis.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail de notificação de leads (SMTP). Deixe em branco para desativar.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Site Bruno Freitas Contabilidade <site@seudominio.com.br>"

# Cloudflare Turnstile (antispam opcional). Sem as duas chaves, o site usa honeypot + limite de envios.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
